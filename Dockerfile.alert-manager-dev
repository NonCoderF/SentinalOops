FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY apps/test-service/tsconfig.json ./apps/test-service/tsconfig.json
COPY apps/alert-manager/backend ./apps/alert-manager/backend
COPY apps/alert-manager/frontend ./apps/alert-manager/frontend
ENV NODE_ENV=development
ENV FRONTEND_NO_CACHE=true
CMD ["sh", "-c", "./node_modules/.bin/tsx apps/alert-manager/backend/src/server.ts & exec npm run dev:frontend -- --host 0.0.0.0"]
