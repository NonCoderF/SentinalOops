generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Incident {
  fingerprint String @id
  status      String
  alertName   String
  service     String
  severity    String
  description String
  startsAt    DateTime?
  endsAt      DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  events      IncidentEvent[]
}

model IncidentEvent {
  id          String   @id
  fingerprint String
  status      String
  payload     Json
  receivedAt  DateTime
  incident    Incident @relation(fields: [fingerprint], references: [fingerprint], onDelete: Cascade)
  @@index([fingerprint, receivedAt])
}

model ProcessedEvent {
  consumer    String
  eventId     String
  fingerprint String
  processedAt DateTime @default(now())
  @@id([consumer, eventId])
}

model EmailDelivery {
  id          String   @id
  fingerprint String?
  event       String
  status      String
  recipients  Json
  subject     String
  error       String?
  createdAt   DateTime @default(now())
  @@index([fingerprint, createdAt])
}
