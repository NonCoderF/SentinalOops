PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
GRAFANA_ADMIN_USER=admin
# Set this in .env or your shell; do not commit the real password.
# GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-password
SENTINELOPS_DASHBOARD_URL=http://localhost:3005
# Optional hardening for a non-local deployment:
# SENTINELOPS_AUTH_ENABLED=true
# SENTINELOPS_ADMIN_TOKEN=replace-with-a-long-management-token
# ALERTMANAGER_WEBHOOK_TOKEN=replace-with-a-long-webhook-token
# SETTINGS_ENCRYPTION_KEY=replace-with-a-long-encryption-key

# Optional real SMTP configuration. Leave blank to configure from the Alert Manager UI.
# For Gmail, use an App Password rather than your normal account password.
# EMAIL_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-google-app-password
# SMTP_FROM=you@gmail.com
# SMTP_RECIPIENTS=you@example.com,oncall@example.com
