FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY apps/test-service/tsconfig.json ./apps/test-service/tsconfig.json
COPY apps/alert-manager/frontend ./apps/alert-manager/frontend
RUN npm run build:frontend

FROM nginx:1.27-alpine
COPY apps/alert-manager/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/alert-manager/frontend/dist /usr/share/nginx/html
EXPOSE 80
