FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY test-service/tsconfig.json ./test-service/tsconfig.json
COPY sentinelops/frontend ./sentinelops/frontend
RUN npm run build:frontend

FROM nginx:1.27-alpine
COPY sentinelops/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/sentinelops/frontend/dist /usr/share/nginx/html
EXPOSE 80
