FROM node:22-alpine AS build
WORKDIR /app
RUN apk add --no-cache python3 make g++
COPY package*.json ./
RUN npm ci
COPY apps/recovery-controller ./apps/recovery-controller
RUN npm run build:recovery-controller

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app/apps/recovery-controller/dist ./apps/recovery-controller/dist
EXPOSE 8090
CMD ["node", "apps/recovery-controller/dist/src/server.js"]
