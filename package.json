{
  "name": "sentinelops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SentinelOps infrastructure observability platform",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:test-service",
    "build:test-service": "tsc -p test-service/tsconfig.json",
    "build:receiver": "tsc -p sentinelops/alert-receiver/tsconfig.json",
    "build:backend": "tsc -p sentinelops/backend/tsconfig.json",
    "build:recovery-controller": "tsc -p sentinelops/recovery-controller/tsconfig.json",
    "build:frontend": "vite build --config sentinelops/frontend/vite.config.ts --configLoader runner",
    "dev:frontend": "vite --config sentinelops/frontend/vite.config.ts",
    "loadtest": "tsx load-testing/src/cli.ts",
    "start": "node test-service/dist/src/server.js",
    "dev": "tsx test-service/src/server.ts",
    "test": "npm run build && npm run build:receiver && npm run build:backend && node --test test-service/dist/test/*.test.js sentinelops/alert-receiver/dist/test/*.test.js sentinelops/backend/dist/test/*.test.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.11",
    "@prisma/client": "^7.10.1",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.6.1",
    "fastify-plugin": "^6.0.1",
    "kafkajs": "^2.2.4",
    "nodemailer": "^10.6.0",
    "prom-client": "^15.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "prisma": "^7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
